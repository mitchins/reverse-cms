# Generate each value independently with: openssl rand -hex 32
REVERSECRM_SESSION_SECRET=replace-me
REVERSECRM_REVIEW_TOKEN=replace-me-with-a-distinct-review-login-token
REVERSECRM_API_TOKEN=replace-me-with-a-distinct-machine-api-token
REVERSECRM_ENVIRONMENT=development
REVERSECRM_BIND_HOST=127.0.0.1
REVERSECRM_BIND_PORT=8080
REVERSECRM_PUBLISH_PORT=8080
REVERSECRM_DATA_DIR=/data
REVERSECRM_INBOX_DIR=/inbox
REVERSECRM_DATABASE_URL=sqlite:////data/reversecrm.sqlite3
REVERSECRM_REVIEWER_ID=local-reviewer
REVERSECRM_MAX_UPLOAD_BYTES=20971520
REVERSECRM_MAX_DOCUMENT_PAGES=50
REVERSECRM_OCR_TIMEOUT_SECONDS=120
REVERSECRM_LOG_LEVEL=INFO
